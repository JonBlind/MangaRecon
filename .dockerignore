# Git
.git
.gitignore

# Environment files and secrets
**/.env
**/.env.*
!**/.env.example

# Python environments and generated files
.venv/
.venv-*/
venv/
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.coverage
