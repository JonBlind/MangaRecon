# Application
MANGARECON_ENV=dev
DEBUG=true
AUTH_SECRET=replace-with-secret
FRONTEND_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Email verification
EMAIL_DELIVERY_MODE=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=MangaRecon
SMTP_STARTTLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=10

# Async PostgreSQL connections used by FastAPI
UserWriterDB=postgresql+asyncpg://your_user:your_password@localhost:5432/mangarecon
UserReaderDB=postgresql+asyncpg://your_user:your_password@localhost:5432/mangarecon
MangaWriterDB=postgresql+asyncpg://your_user:your_password@localhost:5432/mangarecon
MangaReaderDB=postgresql+asyncpg://your_user:your_password@localhost:5432/mangarecon

# Synchronous PostgreSQL connection used by Alembic
DATABASE_URL_SYNC=postgresql+psycopg://your_user:your_password@localhost:5432/mangarecon

# Redis
REDIS_URL=redis://localhost:6379/0

# Optional tuning
CACHE_TTL_SECONDS=3600
RATELIMIT_CHECK_SECONDS=15

# Client connection
MANGAUPDATES_BASE_URL=https://api.mangaupdates.com/v1
MANGAUPDATES_TIMEOUT_SECONDS=10
MANGAUPDATES_MIN_REQUEST_INTERVAL_SECONDS=1
MANGAUPDATES_USER_AGENT=MangaRecon/0.1
