{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mangarecon-api-proxy",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-29",
  "compatibility_flags": [
    "no_nodejs_compat",
    "no_nodejs_compat_v2"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "api.mangarecon.com",
      "custom_domain": true
    }
  ],
  "secrets": {
    "required": [
      "BACKEND_ORIGIN_URL",
      "ORIGIN_VERIFY_SECRET"
    ]
  }
}